# Copy this to .env.local (frontend) and .env (backend) and fill the values

# Frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX

# Backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# Optional - prefer using Price IDs for subscriptions (recommended)
# If you already created Prices in Stripe, add their IDs here
STRIPE_PRICE_PRO_ID=price_xxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_ID=price_xxxxxxxxxxxxxxxxx

# Optional - product IDs (prod_...); backend will create a Price on-the-fly if Price ID is not provided
STRIPE_PRO_PRODUCT_ID=prod_U0ccioBcpVi6DL
STRIPE_ENTERPRISE_PRODUCT_ID=prod_U0cdTpv4RroGFK
