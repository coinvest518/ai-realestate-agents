########################################
# Local development example (.env.local)
########################################
# Public / client
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Server (local only - do NOT commit real secrets)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://user:pass@localhost:5432/postgres
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# Integrations (dev placeholders)
BRIGHT_DATA_API_TOKEN=your_brightdata_token
BRIGHT_DATA_BROWSER_WS=wss://<user>:<pass>@brd.superproxy.io:9222
BRIGHT_DATA_REALTOR_DATASET_ID=gd_xxx
APIFY_API_KEY=apify_api_xxx
APIFY_ID=your_apify_id
APIFY_DEFAULT_PEOPLE_TASK=one-api/skip-trace
TAVILY_API_KEY=tvly_dev_xxx
NEBIUS_API_KEY=nebius_dev_xxx
NEBIUS_MODEL=nebius/meta-llama/Meta-Llama-3.1-8B-Instruct
SCRAPERAPI_KEY=your_scraperapi_key
BROWSERACT_API_KEY=your_browseract_key

# Email (local testing)
SMTP_FROM=you@example.com
SMTP_HOST=smtp.example.com
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_PORT=587
SMTP_SECURE=false

# App-specific
INTEGRATIONS_ENCRYPTION_KEY=replace_with_secure_random_key

# Stripe product IDs (optional)
STRIPE_PRICE_PRO_ID=price_xxx
STRIPE_PRICE_ENTERPRISE_ID=price_xxx
STRIPE_PRO_PRODUCT_ID=prod_xxx
STRIPE_ENTERPRISE_PRODUCT_ID=prod_xxx
